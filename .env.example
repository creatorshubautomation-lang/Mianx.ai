# Mianx.ai — Environment Variables
# Copy this file to .env and fill in your values

# Database (Supabase Postgres for production, SQLite for local dev)
# Local: file:./db/custom.db
# Production: postgresql://postgres.XXX:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=file:./db/custom.db

# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-min-32-chars

# ─────────────────────────────────────────────
# AI Providers (add any/all — automatic fallback)
# ─────────────────────────────────────────────
# Z.ai (free $18 credits — Pakistan friendly)
# Get key: https://z.ai
ZAI_API_KEY=

# Google Gemini (free tier — most generous)
# Get key: https://ai.google.dev
GEMINI_API_KEY=

# Groq (free, fast inference)
# Get key: https://console.groq.com
GROQ_API_KEY=

# OpenAI ($5 free credits)
# Get key: https://platform.openai.com
OPENAI_API_KEY=

# Anthropic ($5 free credits — Claude)
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────
# Stripe (for payments)
# ─────────────────────────────────────────────
# Get keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Webhook secret (for subscription events)
# Setup: Stripe Dashboard → Developers → Webhooks → Add endpoint
#   URL: https://your-app.vercel.app/api/stripe/webhook
#   Events: checkout.session.completed, customer.subscription.updated,
#           customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# Resend (for emails — optional but recommended)
# ─────────────────────────────────────────────
# Get key: https://resend.com/api-keys
RESEND_API_KEY=

# From email address (must be verified in Resend)
EMAIL_FROM="Mianx.ai <noreply@mianx.ai>"
