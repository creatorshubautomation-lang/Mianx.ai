// Mianx.ai — Prisma schema (PostgreSQL for production + Vercel)
// For local SQLite dev, see prisma/schema.sqlite.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
//  USERS & AUTH
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          UserRole  @default(CLIENT)
  company       String?
  phone         String?
  avatarUrl     String?
  preferredLang String    @default("en")
  plan          PlanTier  @default(FREE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects      Project[]
  messages      Message[]
  deliverables  Deliverable[]
  subscriptions Subscription[]
  activities    Activity[]
}

enum UserRole {
  CLIENT
  ADMIN
}

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

model Agent {
  id          String        @id @default(cuid())
  team        AgentTeam
  name        String
  role        String
  description String
  capabilities String
  icon        String
  color       String
  systemPrompt String
  createdAt   DateTime      @default(now())

  assignments ProjectAgent[]
  messages    Message[]

  @@unique([team, name])
}

enum AgentTeam {
  DESIGN
  DEVELOPMENT
  CONTENT
  MARKETING
  QA
  SUPPORT
}

model Project {
  id          String         @id @default(cuid())
  clientId    String
  title       String
  description String
  projectType String
  requirements String
  status      ProjectStatus  @default(BRIEFING)
  priority    String         @default("normal")
  budget      Float?
  deadline    DateTime?
  progress    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  client      User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agents      ProjectAgent[]
  tasks       Task[]
  messages    Message[]
  deliverables Deliverable[]
  activities  Activity[]

  @@index([clientId])
}

enum ProjectStatus {
  BRIEFING
  PLANNING
  IN_PROGRESS
  REVIEW
  DELIVERED
  COMPLETED
  ON_HOLD
  CANCELLED
}

model ProjectAgent {
  id        String   @id @default(cuid())
  projectId String
  agentId   String
  status    String   @default("assigned")
  progress  Int      @default(0)
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent     Agent    @relation(fields: [agentId], references: [id])

  @@unique([projectId, agentId])
}

model Task {
  id          String   @id @default(cuid())
  projectId   String
  assignedAgentId String?
  title       String
  description String?
  status      String   @default("todo")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  projectId String?
  userId    String?
  agentId   String?
  role      String
  content   String
  meta      String?
  createdAt DateTime @default(now())

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model Deliverable {
  id         String   @id @default(cuid())
  projectId  String
  uploadedBy String
  title      String
  description String?
  fileType   String
  content    String
  fileName   String?
  fileSize   Int?
  createdAt  DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader   User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  plan      PlanTier
  status    String   @default("active")
  startDate DateTime @default(now())
  endDate   DateTime?
  amount    Float
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  projectId String?
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

// ─────────────────────────────────────────────
//  AI PROVIDER USAGE (track API calls + costs)
// ─────────────────────────────────────────────

model AiProviderUsage {
  id            String   @id @default(cuid())
  provider      String   // zai | gemini | groq | openai | anthropic | cloudflare
  endpoint      String   // chat | analyze | deliverable
  agentName     String?
  projectId     String?
  userId        String?
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  totalTokens   Int      @default(0)
  costUsd       Float    @default(0)
  status        String   @default("success") // success | failed | rate_limited | quota_exceeded
  errorMessage  String?
  responseTimeMs Int?
  createdAt     DateTime @default(now())

  @@index([provider, createdAt])
  @@index([projectId])
}

// ─────────────────────────────────────────────
//  AI PROVIDER CONFIG (dynamic provider settings)
// ─────────────────────────────────────────────

model AiProviderConfig {
  id              String   @id @default(cuid())
  provider        String   @unique
  displayName     String
  enabled         Boolean  @default(true)
  priority        Int      @default(0)
  envKeyName      String
  freeLimitUsd    Float    @default(0)
  usedUsd         Float    @default(0)
  models          String   @default("[]")
  lastResetAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────
//  PASSWORD RESET (forgot password flow)
// ─────────────────────────────────────────────

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ─────────────────────────────────────────────
//  SUPPORT TICKETS (client → admin support)
// ─────────────────────────────────────────────

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  description String
  priority    String   @default("normal") // low | normal | high | urgent
  status      String   @default("open") // open | in_progress | resolved | closed
  category    String   @default("general") // general | billing | technical | bug | feature
  projectId   String?
  response    String?
  respondedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────────
//  AGENT MEMORY (D3 — agents remember client preferences)
// ─────────────────────────────────────────────

model AgentMemory {
  id          String   @id @default(cuid())
  projectId   String
  agentId     String
  memoryType  String   // preference | decision | feedback | fact
  key         String   // e.g., "preferred_color", "brand_voice"
  value       String   // e.g., "blue", "casual"
  confidence  Float    @default(1.0) // 0.0 to 1.0
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([agentId])
  @@unique([projectId, agentId, key])
}

// ─────────────────────────────────────────────
//  NOTIFICATION (D5 — smart notifications)
// ─────────────────────────────────────────────

model Notification {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  type        String   // project_update | deliverable_ready | agent_response | milestone | warning
  title       String
  message     String
  priority    String   @default("normal") // low | normal | high | urgent
  isRead      Boolean  @default(false)
  actionUrl   String?
  metadata    String?  // JSON
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
  @@index([projectId])
}

// ─────────────────────────────────────────────
//  AGENT ACTIVITY LOG (D2 — real-time agent activity)
// ─────────────────────────────────────────────

model AgentActivity {
  id          String   @id @default(cuid())
  projectId   String
  agentId     String?
  agentName   String
  activity    String   // thinking | coding | designing | writing | testing | reviewing | done
  description String
  progress    Int      @default(0) // 0-100
  isLive      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([isLive])
}

// ─────────────────────────────────────────────
//  MIANX ACADEMY (E2 — Course Platform)
// ─────────────────────────────────────────────

model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  instructor  String
  category    String   @default("general") // general | coding | business | design | marketing | ai
  level       String   @default("beginner") // beginner | intermediate | advanced
  price       Float    @default(0)
  currency    String   @default("USD")
  thumbnail   String?
  previewUrl  String?
  duration    Int      @default(60) // total minutes
  lessons     Lesson[]
  enrollments Enrollment[]
  rating      Float    @default(5.0)
  reviewCount Int      @default(0)
  studentCount Int     @default(0)
  isPublished Boolean  @default(true)
  isPremium   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  content     String
  videoUrl    String?
  duration    Int      @default(10) // minutes
  order       Int      @default(0)
  isPreview   Boolean  @default(false) // free preview lesson
  createdAt   DateTime @default(now())

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  progress    Int      @default(0) // 0-100
  completedLessons String @default("[]") // JSON array of lesson IDs
  enrolledAt  DateTime @default(now())
  completedAt DateTime?
  lastAccessed DateTime?

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

// ─────────────────────────────────────────────
//  AI AGENT MARKETPLACE (E5 — Custom Agents)
// ─────────────────────────────────────────────

model CustomAgent {
  id            String   @id @default(cuid())
  creatorId     String
  name          String
  description   String
  category      String   @default("general") // general | legal | finance | health | education | real_estate | custom
  icon          String   @default("Bot")
  color         String   @default("from-purple-500 to-cyan-500")
  systemPrompt  String
  capabilities  String   @default("[]") // JSON array
  price         Float    @default(0) // 0 = free
  currency      String   @default("USD")
  rating        Float    @default(5.0)
  downloadCount Int      @default(0)
  isPublished   Boolean  @default(true)
  isVerified    Boolean  @default(false)
  tags          String   @default("[]") // JSON array
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([creatorId])
}

// ─────────────────────────────────────────────
//  WHITE-LABEL SETTINGS (E3)
// ─────────────────────────────────────────────

model WhiteLabelConfig {
  id            String   @id @default(cuid())
  userId        String   @unique
  brandName     String   @default("Mianx.ai")
  brandLogo     String?
  brandColor    String   @default("#a855f7")
  accentColor   String   @default("#06b6d4")
  customDomain  String?
  isWhiteLabel  Boolean  @default(false)
  plan          String   @default("standard") // standard | pro | enterprise
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
