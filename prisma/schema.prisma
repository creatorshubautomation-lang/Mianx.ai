// Mianx.ai — Prisma schema (SQLite for local dev)
// For Vercel/Postgres deployment, copy prisma/schema.postgres.prisma
// over this file before building.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
//  USERS & AUTH
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          UserRole  @default(CLIENT)
  company       String?
  phone         String?
  avatarUrl     String?
  preferredLang String    @default("en")
  plan          PlanTier  @default(FREE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects      Project[]
  messages      Message[]
  deliverables  Deliverable[]
  subscriptions Subscription[]
  activities    Activity[]
}

enum UserRole {
  CLIENT
  ADMIN
}

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

model Agent {
  id          String        @id @default(cuid())
  team        AgentTeam
  name        String
  role        String
  description String
  capabilities String
  icon        String
  color       String
  systemPrompt String
  createdAt   DateTime      @default(now())

  assignments ProjectAgent[]
  messages    Message[]

  @@unique([team, name])
}

enum AgentTeam {
  DESIGN
  DEVELOPMENT
  CONTENT
  MARKETING
  QA
  SUPPORT
}

model Project {
  id          String         @id @default(cuid())
  clientId    String
  title       String
  description String
  projectType String
  requirements String
  status      ProjectStatus  @default(BRIEFING)
  priority    String         @default("normal")
  budget      Float?
  deadline    DateTime?
  progress    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  client      User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agents      ProjectAgent[]
  tasks       Task[]
  messages    Message[]
  deliverables Deliverable[]
  activities  Activity[]

  @@index([clientId])
}

enum ProjectStatus {
  BRIEFING
  PLANNING
  IN_PROGRESS
  REVIEW
  DELIVERED
  COMPLETED
  ON_HOLD
  CANCELLED
}

model ProjectAgent {
  id        String   @id @default(cuid())
  projectId String
  agentId   String
  status    String   @default("assigned")
  progress  Int      @default(0)
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent     Agent    @relation(fields: [agentId], references: [id])

  @@unique([projectId, agentId])
}

model Task {
  id          String   @id @default(cuid())
  projectId   String
  assignedAgentId String?
  title       String
  description String?
  status      String   @default("todo")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  projectId String?
  userId    String?
  agentId   String?
  role      String
  content   String
  meta      String?
  createdAt DateTime @default(now())

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model Deliverable {
  id         String   @id @default(cuid())
  projectId  String
  uploadedBy String
  title      String
  description String?
  fileType   String
  content    String
  fileName   String?
  fileSize   Int?
  createdAt  DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader   User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  plan      PlanTier
  status    String   @default("active")
  startDate DateTime @default(now())
  endDate   DateTime?
  amount    Float
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  projectId String?
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
}
