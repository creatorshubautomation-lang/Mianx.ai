// Mianx.ai — Prisma schema (PostgreSQL for production + Vercel)
// For local SQLite dev, see prisma/schema.sqlite.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
//  USERS & AUTH
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          UserRole  @default(CLIENT)
  company       String?
  phone         String?
  avatarUrl     String?
  preferredLang String    @default("en")
  plan          PlanTier  @default(FREE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects      Project[]
  messages      Message[]
  deliverables  Deliverable[]
  subscriptions Subscription[]
  activities    Activity[]
  supportTickets SupportTicket[]
  missions      Mission[]     @relation("MissionOwner")
}

enum UserRole {
  CLIENT
  ADMIN
}

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

model Agent {
  id          String        @id @default(cuid())
  team        AgentTeam
  name        String
  role        String
  description String
  capabilities String
  icon        String
  color       String
  systemPrompt String
  createdAt   DateTime      @default(now())

  assignments ProjectAgent[]
  messages    Message[]

  @@unique([team, name])
}

enum AgentTeam {
  DESIGN
  DEVELOPMENT
  CONTENT
  MARKETING
  QA
  SUPPORT
}

model Project {
  id          String         @id @default(cuid())
  clientId    String
  title       String
  description String
  projectType String
  requirements String
  status      ProjectStatus  @default(BRIEFING)
  priority    String         @default("normal")
  budget      Float?
  deadline    DateTime?
  progress    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  client      User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agents      ProjectAgent[]
  tasks       Task[]
  messages    Message[]
  deliverables Deliverable[]
  activities  Activity[]
  missions    Mission[]

  @@index([clientId])
}

enum ProjectStatus {
  BRIEFING
  PLANNING
  IN_PROGRESS
  REVIEW
  DELIVERED
  COMPLETED
  ON_HOLD
  CANCELLED
}

model ProjectAgent {
  id        String   @id @default(cuid())
  projectId String
  agentId   String
  status    String   @default("assigned")
  progress  Int      @default(0)
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent     Agent    @relation(fields: [agentId], references: [id])

  @@unique([projectId, agentId])
}

model Task {
  id          String   @id @default(cuid())
  projectId   String
  assignedAgentId String?
  title       String
  description String?
  status      String   @default("todo")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([assignedAgentId])
}

model Message {
  id        String   @id @default(cuid())
  projectId String?
  userId    String?
  agentId   String?
  role      String
  content   String
  meta      String?
  createdAt DateTime @default(now())

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([agentId])
}

model Deliverable {
  id         String   @id @default(cuid())
  projectId  String
  uploadedBy String
  title      String
  description String?
  fileType   String
  content    String   // for uploaded binaries, base64-encoded (see contentEncoding)
  contentEncoding String @default("utf8") // "utf8" | "base64"
  mimeType   String?  // real MIME type, e.g. "image/png" — used for download headers
  fileName   String?
  fileSize   Int?
  createdAt  DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader   User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([uploadedBy])
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  plan                   PlanTier
  status                 String    @default("active")
  startDate              DateTime  @default(now())
  endDate                DateTime?
  amount                 Float
  currency               String    @default("USD")
  stripeCustomerId       String?
  stripeSubscriptionId   String?   @unique
  stripeCheckoutSessionId String?  @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeCustomerId])
}

// Tracks processed Stripe webhook event IDs so retried/duplicate
// deliveries (which Stripe sends by design) are only applied once.
model WebhookEvent {
  id          String   @id // Stripe event.id — natural idempotency key
  type        String
  processedAt DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  projectId String?
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────
//  AI PROVIDER USAGE (track API calls + costs)
// ─────────────────────────────────────────────

model AiProviderUsage {
  id            String   @id @default(cuid())
  provider      String   // zai | gemini | groq | openai | anthropic | cloudflare
  endpoint      String   // chat | analyze | deliverable
  tier          String   @default("fast") // fast | quality — which model tier was used
  agentName     String?
  projectId     String?
  userId        String?
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  totalTokens   Int      @default(0)
  costUsd       Float    @default(0)
  status        String   @default("success") // success | failed | rate_limited | quota_exceeded
  errorMessage  String?
  responseTimeMs Int?
  createdAt     DateTime @default(now())

  @@index([provider, createdAt])
  @@index([projectId])
  @@index([userId, createdAt])
  @@index([tier])
}

// ─────────────────────────────────────────────
//  AI PROVIDER CONFIG (dynamic provider settings)
// ─────────────────────────────────────────────

model AiProviderConfig {
  id              String   @id @default(cuid())
  provider        String   @unique
  displayName     String
  enabled         Boolean  @default(true)
  priority        Int      @default(0)
  envKeyName      String
  freeLimitUsd    Float    @default(0)
  usedUsd         Float    @default(0)
  models          String   @default("[]")
  lastResetAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────
//  PASSWORD RESET (forgot password flow)
// ─────────────────────────────────────────────

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ─────────────────────────────────────────────
//  SUPPORT TICKETS (client → admin support)
// ─────────────────────────────────────────────

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  description String
  priority    String   @default("normal") // low | normal | high | urgent
  status      String   @default("open") // open | in_progress | resolved | closed
  category    String   @default("general") // general | billing | technical | bug | feature
  projectId   String?
  response    String?
  respondedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────────
//  AGENT MEMORY (D3 — agents remember client preferences)
//  Phase 4: Added clientId for cross-project memory scope
// ─────────────────────────────────────────────

model AgentMemory {
  id          String   @id @default(cuid())
  projectId   String
  agentId     String
  clientId    String?  // Phase 4: nullable — when set, memory applies across all client's projects
  memoryType  String   // preference | decision | feedback | fact
  key         String   // e.g., "preferred_color", "brand_voice", "writing_style"
  value       String   // e.g., "blue", "casual", "concise/punchy"
  confidence  Float    @default(1.0) // 0.0 to 1.0
  source      String   @default("regex") // regex | llm — how this memory was extracted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([agentId])
  @@index([clientId])
  @@unique([projectId, agentId, key])
}

// ─────────────────────────────────────────────
//  CLIENT MEMORY (Phase 4 — cross-project client preferences)
//  High-confidence memories that persist across all projects
//  for a given client. Populated from AgentMemory entries with
//  confidence >= 0.8 and broad applicability.
// ─────────────────────────────────────────────

model ClientMemory {
  id          String   @id @default(cuid())
  userId      String   // the client/user
  memoryType  String   // preference | decision | feedback | fact
  key         String   // e.g., "writing_style", "preferred_color"
  value       String   // e.g., "concise/punchy", "blue"
  confidence  Float    @default(0.9) // 0.0 to 1.0 — only high-confidence memories promoted here
  sourceProjectId String? // which project this was first learned from
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@unique([userId, key])
}

// ─────────────────────────────────────────────
//  NOTIFICATION (D5 — smart notifications)
// ─────────────────────────────────────────────

model Notification {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  type        String   // project_update | deliverable_ready | agent_response | milestone | warning
  title       String
  message     String
  priority    String   @default("normal") // low | normal | high | urgent
  isRead      Boolean  @default(false)
  actionUrl   String?
  metadata    String?  // JSON
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
  @@index([projectId])
}

// ─────────────────────────────────────────────
//  AGENT ACTIVITY LOG (D2 — real-time agent activity)
// ─────────────────────────────────────────────

model AgentActivity {
  id          String   @id @default(cuid())
  projectId   String
  agentId     String?
  agentName   String
  activity    String   // thinking | coding | designing | writing | testing | reviewing | done
  description String
  progress    Int      @default(0) // 0-100
  isLive      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([isLive])
}

// ─────────────────────────────────────────────
//  MIANX ACADEMY (E2 — Course Platform)
// ─────────────────────────────────────────────

model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  instructor  String
  category    String   @default("general") // general | coding | business | design | marketing | ai
  level       String   @default("beginner") // beginner | intermediate | advanced
  price       Float    @default(0)
  currency    String   @default("USD")
  thumbnail   String?
  previewUrl  String?
  duration    Int      @default(60) // total minutes
  lessons     Lesson[]
  enrollments Enrollment[]
  rating      Float    @default(5.0)
  reviewCount Int      @default(0)
  studentCount Int     @default(0)
  isPublished Boolean  @default(true)
  isPremium   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([title])

  @@index([category])
  @@index([isPublished])
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  content     String
  videoUrl    String?
  duration    Int      @default(10) // minutes
  order       Int      @default(0)
  isPreview   Boolean  @default(false) // free preview lesson
  createdAt   DateTime @default(now())

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@unique([courseId, order])
}

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  progress    Int      @default(0) // 0-100
  completedLessons String @default("[]") // JSON array of lesson IDs
  enrolledAt  DateTime @default(now())
  completedAt DateTime?
  lastAccessed DateTime?

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

// ─────────────────────────────────────────────
//  AI AGENT MARKETPLACE (E5 — Custom Agents)
// ─────────────────────────────────────────────

model CustomAgent {
  id            String   @id @default(cuid())
  creatorId     String
  name          String
  description   String
  category      String   @default("general") // general | legal | finance | health | education | real_estate | custom
  icon          String   @default("Bot")
  color         String   @default("from-purple-500 to-cyan-500")
  systemPrompt  String
  capabilities  String   @default("[]") // JSON array
  price         Float    @default(0) // 0 = free
  currency      String   @default("USD")
  rating        Float    @default(5.0)
  downloadCount Int      @default(0)
  isPublished   Boolean  @default(true)
  isVerified    Boolean  @default(false)
  tags          String   @default("[]") // JSON array
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([creatorId])
  @@unique([creatorId, name])
}

// ─────────────────────────────────────────────
//  WHITE-LABEL SETTINGS (E3)
// ─────────────────────────────────────────────

model WhiteLabelConfig {
  id            String   @id @default(cuid())
  userId        String   @unique
  brandName     String   @default("Mianx.ai")
  brandLogo     String?
  brandColor    String   @default("#a855f7")
  accentColor   String   @default("#06b6d4")
  customDomain  String?
  isWhiteLabel  Boolean  @default(false)
  plan          String   @default("standard") // standard | pro | enterprise
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────────
//  AGENT TOOL CALLS (Phase 2 — tool usage tracking)
// ─────────────────────────────────────────────

model AgentToolCall {
  id          String   @id @default(cuid())
  provider    String   // which AI provider executed the tool
  toolName    String   // code_verify | web_search | ...
  agentName   String?
  projectId   String?
  userId      String?
  input       String?  // JSON — tool input parameters
  output      String?  // JSON — tool result
  status      String   @default("success") // success | failed | skipped
  durationMs  Int?
  createdAt   DateTime @default(now())

  @@index([provider, createdAt])
  @@index([projectId])
  @@index([userId, createdAt])
  @@index([toolName])
}

// ─────────────────────────────────────────────
//  MISSION ENGINE (Phase 2 — Agentic AI Platform)
//  First-class Mission concept: a mission is a high-level
//  objective that the AI system autonomously plans and
//  executes through a dependency-aware task graph.
// ─────────────────────────────────────────────

enum MissionStatus {
  DRAFT           // User created, not yet submitted
  PLANNING        // AI Planner is generating the execution plan
  AWAITING_APPROVAL // Plan ready, waiting for human approval
  APPROVED        // Plan approved, ready to execute
  EXECUTING       // Agent loop is actively running tasks
  PAUSED          // Execution paused by user or system
  VERIFYING       // Verification engine checking task outputs
  REPAIRING       // Auto-repair loop fixing failed verifications
  COMPLETED       // All tasks done + verified
  FAILED          // Unrecoverable failure (max retries exceeded)
  CANCELLED       // User cancelled the mission
}

enum MissionTaskStatus {
  PENDING         // Waiting for dependencies to complete
  READY           // All dependencies met, ready to execute
  RUNNING         // Agent is actively working on this task
  COMPLETED       // Task output verified and accepted
  FAILED          // Task failed (will be retried or escalated)
  SKIPPED         // Task skipped (dependency failed or unnecessary)
  CANCELLED       // Task cancelled
}

enum MissionEventType {
  CREATED
  STATUS_CHANGED
  PLAN_GENERATED
  PLAN_APPROVED
  PLAN_REJECTED
  TASK_STARTED
  TASK_COMPLETED
  TASK_FAILED
  TASK_RETRIED
  VERIFICATION_PASSED
  VERIFICATION_FAILED
  REPAIR_STARTED
  REPAIR_COMPLETED
  BUDGET_WARNING
  BUDGET_EXCEEDED
  HUMAN_APPROVAL_REQUESTED
  HUMAN_APPROVED
  HUMAN_REJECTED
  MISSION_COMPLETED
  MISSION_FAILED
  MISSION_CANCELLED
  AGENT_LOOP_STARTED
  AGENT_LOOP_ITERATION
  AGENT_LOOP_REFLECTION
  AGENT_LOOP_COMPLETED
  ERROR
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ToolCategory {
  FILE
  CODE
  GIT
  DATABASE
  WEB
  DEPLOY
  AI
  SYSTEM
}

model Mission {
  id            String          @id @default(cuid())
  userId        String          // owner / creator
  projectId     String?         // optional link to existing Project
  title         String
  description   String           // user's objective in natural language
  status        MissionStatus   @default(DRAFT)
  priority      String          @default("normal") // low | normal | high | critical

  // Planning
  planJson      String?         // JSON: the structured execution plan
  planSummary   String?         // human-readable plan summary
  planReasoning String?         // why this plan was chosen
  approvedBy    String?         // who approved (userId or "auto")
  approvedAt    DateTime?

  // Execution metadata
  totalTasks    Int             @default(0)
  completedTasks Int            @default(0)
  failedTasks   Int             @default(0)
  progress      Int            @default(0) // 0-100 auto-calculated

  // Budget control
  budgetUsd     Float?          // max allowed spend (null = unlimited)
  spentUsd      Float           @default(0) // actual AI costs incurred

  // Timing
  startedAt     DateTime?
  completedAt   DateTime?
  deadline      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  user          User            @relation("MissionOwner", fields: [userId], references: [id], onDelete: Cascade)
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tasks         MissionTask[]
  events        MissionEvent[]
  approvals     HumanApproval[]

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([createdAt])
}

model MissionTask {
  id            String              @id @default(cuid())
  missionId     String
  parentTaskId  String?             // for sub-task hierarchy
  title         String
  description   String?             // detailed task description
  status        MissionTaskStatus   @default(PENDING)
  priority      Int                 @default(0) // execution priority (higher = first)

  // Dependency graph
  dependencies  String              @default("[]") // JSON array of MissionTask IDs this depends on
  dependents    String              @default("[]") // JSON array of MissionTask IDs that depend on this

  // Agent assignment
  assignedAgent String?            // agent name from AGENT_CATALOG
  agentTeam     String?
  agentRole     String?

  // Tool requirements
  requiredTools String              @default("[]") // JSON array of tool names needed
  riskLevel     RiskLevel           @default(LOW)

  // Execution
  input         String?             // JSON — task input/context
  output        String?             // JSON — task result/output
  outputType    String?             // code | text | file | url | json
  verificationStatus String?        // pending | passed | failed
  verificationResult String?        // JSON — verification details
  retryCount    Int                 @default(0)
  maxRetries    Int                 @default(3)

  // Human approval
  approvalStatus ApprovalStatus     @default(NOT_REQUIRED)
  approvalReason String?

  // Timing
  order         Int                 @default(0) // visual order
  startedAt     DateTime?
  completedAt   DateTime?
  durationMs    Int?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  // Relations
  mission       Mission             @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId])
  @@index([status])
  @@index([assignedAgent])
  @@index([parentTaskId])
}

// Audit log for everything that happens in a Mission
model MissionEvent {
  id            String              @id @default(cuid())
  missionId     String
  taskId        String?             // related task (if applicable)
  eventType     MissionEventType
  title         String              // human-readable event title
  description   String?             // detailed description
  metadata      String?             // JSON — any extra data
  level         String              @default("info") // info | warn | error | success
  createdAt     DateTime            @default(now())

  mission       Mission             @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, createdAt])
  @@index([eventType])
  @@index([taskId])
}

// Human-in-the-loop approval records
model HumanApproval {
  id            String              @id @default(cuid())
  missionId     String
  taskId        String?             // task-level approval (null = mission-level)
  userId        String              // who needs to approve
  status        ApprovalStatus      @default(PENDING)
  title         String              // what needs approval
  description   String?             // details about what's being approved
  riskLevel     RiskLevel           @default(MEDIUM)
  metadata      String?             // JSON — action details (tool name, input, etc.)
  respondedAt   DateTime?
  responseNote  String?             // approver's note
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  mission       Mission             @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId])
  @@index([userId, status])
  @@index([status])
}

// ─────────────────────────────────────────────
//  TOOL REGISTRY (Phase 2 — Secure, permissioned tools)
// ─────────────────────────────────────────────

model ToolDefinition {
  id            String              @id @default(cuid())
  name          String              @unique
  displayName   String
  description   String
  category      ToolCategory
  riskLevel     RiskLevel           @default(MEDIUM)

  // Schema for structured input/output
  inputSchema   String              @default("{}") // JSON Schema for input validation
  outputSchema  String?             // JSON Schema for expected output

  // Execution
  handler       String              // function name in tool-handlers.ts
  timeoutMs     Int                 @default(30000)
  retryable     Boolean             @default(true)
  maxRetries    Int                 @default(2)

  // Permissions
  requireApproval Boolean          @default(false) // HIGH/CRITICAL tools need human approval
  allowedAgents String             @default("[]") // JSON array of agent names (empty = all)
  allowedPlans  String              @default("[]") // JSON array of plan tiers (empty = all)

  // Cost
  costPerCall   Float               @default(0)

  enabled       Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([category])
  @@index([riskLevel])
  @@index([enabled])
}

// ─────────────────────────────────────────────
//  MARKETPLACE ENHANCEMENT (Phase 10)
//  Reviews, installs, and discovery for agents
// ─────────────────────────────────────────────

model AgentReview {
  id            String   @id @default(cuid())
  agentId       String
  userId        String
  rating        Int      // 1-5 stars
  title         String?  // optional review title
  body          String?  // optional review body
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([agentId, userId]) // one review per user per agent
  @@index([agentId])
  @@index([userId])
}

model AgentInstall {
  id            String   @id @default(cuid())
  agentId       String
  userId        String
  installedAt   DateTime @default(now())

  @@unique([agentId, userId]) // can only install once
  @@index([agentId])
  @@index([userId])
}
