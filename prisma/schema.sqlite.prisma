// Mianx.ai — Agentic Software House Platform
// Prisma schema for full SaaS: clients, projects, agents, chat, deliverables, subscriptions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
//  USERS & AUTH
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          UserRole  @default(CLIENT)
  company       String?
  phone         String?
  avatarUrl     String?
  preferredLang String    @default("en") // en | ur | roman
  plan          PlanTier  @default(FREE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects      Project[]
  messages      Message[]
  deliverables  Deliverable[]
  subscriptions Subscription[]
  activities    Activity[]
}

enum UserRole {
  CLIENT
  ADMIN
}

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

// ─────────────────────────────────────────────
//  AGENT TEAMS (catalog of agent types)
// ─────────────────────────────────────────────

model Agent {
  id          String        @id @default(cuid())
  team        AgentTeam
  name        String
  role        String
  description String
  capabilities String       // JSON string of capabilities array
  icon        String        // lucide icon name
  color       String        // gradient color theme
  systemPrompt String       // system prompt for LLM
  createdAt   DateTime      @default(now())

  assignments ProjectAgent[]
  messages    Message[]

  @@unique([team, name])
}

enum AgentTeam {
  DESIGN
  DEVELOPMENT
  CONTENT
  MARKETING
  QA
  SUPPORT
}

// ─────────────────────────────────────────────
//  PROJECTS (client work)
// ─────────────────────────────────────────────

model Project {
  id          String         @id @default(cuid())
  clientId    String
  title       String
  description String
  projectType String         // web | mobile | branding | content | marketing | full_stack
  requirements String        // JSON string of requirements
  status      ProjectStatus  @default(BRIEFING)
  priority    String         @default("normal") // low | normal | high | urgent
  budget      Float?
  deadline    DateTime?
  progress    Int            @default(0) // 0-100
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  client      User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agents      ProjectAgent[]
  tasks       Task[]
  messages    Message[]
  deliverables Deliverable[]
  activities  Activity[]

  @@index([clientId])
}

enum ProjectStatus {
  BRIEFING
  PLANNING
  IN_PROGRESS
  REVIEW
  DELIVERED
  COMPLETED
  ON_HOLD
  CANCELLED
}

model ProjectAgent {
  id        String   @id @default(cuid())
  projectId String
  agentId   String
  status    String   @default("assigned") // assigned | working | waiting | done | paused
  progress  Int      @default(0)
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent     Agent    @relation(fields: [agentId], references: [id])

  @@unique([projectId, agentId])
}

// ─────────────────────────────────────────────
//  TASKS (per project, assigned to agents)
// ─────────────────────────────────────────────

model Task {
  id          String   @id @default(cuid())
  projectId   String
  assignedAgentId String?
  title       String
  description String?
  status      String   @default("todo") // todo | in_progress | review | done | blocked
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([assignedAgentId])
}

// ─────────────────────────────────────────────
//  CHAT (between client and agents)
// ─────────────────────────────────────────────

model Message {
  id        String   @id @default(cuid())
  projectId String?
  userId    String?  // null if from agent
  agentId   String?  // null if from user
  role      String   // user | agent | system
  content   String
  meta      String?  // JSON metadata
  createdAt DateTime @default(now())

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([agentId])
}

// ─────────────────────────────────────────────
//  DELIVERABLES (files / outputs)
// ─────────────────────────────────────────────

model Deliverable {
  id         String   @id @default(cuid())
  projectId  String
  uploadedBy String
  title      String
  description String?
  fileType   String   // code | document | design | report | archive
  content    String   // text content, or base64 for uploaded binaries (see contentEncoding)
  contentEncoding String @default("utf8") // "utf8" | "base64"
  mimeType   String?  // real MIME type, e.g. "image/png" — used for download headers
  fileName   String?
  fileSize   Int?
  createdAt  DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader   User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ─────────────────────────────────────────────
//  SUBSCRIPTIONS / PRICING
// ─────────────────────────────────────────────

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  plan                   PlanTier
  status                 String    @default("active") // active | cancelled | expired | past_due
  startDate              DateTime  @default(now())
  endDate                DateTime?
  amount                 Float
  currency               String    @default("USD")
  stripeCustomerId       String?
  stripeSubscriptionId   String?   @unique
  stripeCheckoutSessionId String?  @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// ─────────────────────────────────────────────
//  ACTIVITY LOG (audit trail)
// ─────────────────────────────────────────────

model Activity {
  id        String   @id @default(cuid())
  projectId String?
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────
//  AI PROVIDER USAGE (track API calls + costs)
// ─────────────────────────────────────────────

model AiProviderUsage {
  id            String   @id @default(cuid())
  provider      String
  endpoint      String
  tier          String   @default("fast")
  agentName     String?
  projectId     String?
  userId        String?
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  totalTokens   Int      @default(0)
  costUsd       Float    @default(0)
  status        String   @default("success")
  errorMessage  String?
  responseTimeMs Int?
  createdAt     DateTime @default(now())

  @@index([provider, createdAt])
  @@index([projectId])
  @@index([userId, createdAt])
  @@index([tier])
}

// ─────────────────────────────────────────────
//  AI PROVIDER CONFIG (dynamic provider settings)
// ─────────────────────────────────────────────

model AiProviderConfig {
  id              String   @id @default(cuid())
  provider        String   @unique
  displayName     String
  enabled         Boolean  @default(true)
  priority        Int      @default(0)
  envKeyName      String
  freeLimitUsd    Float    @default(0)
  usedUsd         Float    @default(0)
  models          String   @default("[]")
  lastResetAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────
//  PASSWORD RESET
// ─────────────────────────────────────────────

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ─────────────────────────────────────────────
//  SUPPORT TICKETS
// ─────────────────────────────────────────────

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  description String
  priority    String   @default("normal")
  status      String   @default("open")
  category    String   @default("general")
  projectId   String?
  response    String?
  respondedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────────
//  AGENT MEMORY
//  Phase 4: Added clientId for cross-project memory scope
// ─────────────────────────────────────────────

model AgentMemory {
  id          String   @id @default(cuid())
  projectId   String
  agentId     String
  clientId    String?  // Phase 4: nullable — when set, memory applies across all client's projects
  memoryType  String
  key         String
  value       String
  confidence  Float    @default(1.0)
  source      String   @default("regex") // regex | llm
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([agentId])
  @@index([clientId])
  @@unique([projectId, agentId, key])
}

// ─────────────────────────────────────────────
//  CLIENT MEMORY (Phase 4 — cross-project client preferences)
// ─────────────────────────────────────────────

model ClientMemory {
  id          String   @id @default(cuid())
  userId      String
  memoryType  String
  key         String
  value       String
  confidence  Float    @default(0.9)
  sourceProjectId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@unique([userId, key])
}

// ─────────────────────────────────────────────
//  NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  type        String
  title       String
  message     String
  priority    String   @default("normal")
  isRead      Boolean  @default(false)
  actionUrl   String?
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
  @@index([projectId])
}

// ─────────────────────────────────────────────
//  AGENT ACTIVITY LOG
// ─────────────────────────────────────────────

model AgentActivity {
  id          String   @id @default(cuid())
  projectId   String
  agentId     String?
  agentName   String
  activity    String
  description String
  progress    Int      @default(0)
  isLive      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([isLive])
}

// ─────────────────────────────────────────────
//  MIANX ACADEMY
// ─────────────────────────────────────────────

model Course {
  id            String   @id @default(cuid())
  title         String   @unique
  description   String
  instructor    String
  category      String   @default("general")
  level         String   @default("beginner")
  price         Float    @default(0)
  currency      String   @default("USD")
  thumbnail     String?
  previewUrl    String?
  duration      Int      @default(60)
  rating        Float    @default(5.0)
  reviewCount   Int      @default(0)
  studentCount  Int      @default(0)
  isPublished   Boolean  @default(true)
  isPremium     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]

  @@index([category])
  @@index([isPublished])
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  content     String
  videoUrl    String?
  duration    Int      @default(10)
  order       Int      @default(0)
  isPreview   Boolean  @default(false)
  createdAt   DateTime @default(now())

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@unique([courseId, order])
}

model Enrollment {
  id                String   @id @default(cuid())
  userId            String
  courseId          String
  progress          Int      @default(0)
  completedLessons  String   @default("[]")
  enrolledAt        DateTime @default(now())
  completedAt       DateTime?
  lastAccessed       DateTime?

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

// ─────────────────────────────────────────────
//  AI AGENT MARKETPLACE
// ─────────────────────────────────────────────

model CustomAgent {
  id            String   @id @default(cuid())
  creatorId     String
  name          String
  description   String
  category      String   @default("general")
  icon          String   @default("Bot")
  color         String   @default("from-purple-500 to-cyan-500")
  systemPrompt  String
  capabilities  String   @default("[]")
  price         Float    @default(0)
  currency      String   @default("USD")
  rating        Float    @default(5.0)
  downloadCount Int      @default(0)
  isPublished   Boolean  @default(true)
  isVerified    Boolean  @default(false)
  tags          String   @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([creatorId])
  @@unique([creatorId, name])
}

// ─────────────────────────────────────────────
//  WHITE-LABEL SETTINGS
// ─────────────────────────────────────────────

model WhiteLabelConfig {
  id            String   @id @default(cuid())
  userId        String   @unique
  brandName     String   @default("Mianx.ai")
  brandLogo     String?
  brandColor    String   @default("#a855f7")
  accentColor   String   @default("#06b6d4")
  customDomain  String?
  isWhiteLabel  Boolean  @default(false)
  plan          String   @default("standard")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────────
//  AGENT TOOL CALLS (Phase 2 — tool usage tracking)
// ─────────────────────────────────────────────

model AgentToolCall {
  id          String   @id @default(cuid())
  provider    String
  toolName    String
  agentName   String?
  projectId   String?
  userId      String?
  input       String?
  output      String?
  status      String   @default("success")
  durationMs  Int?
  createdAt   DateTime @default(now())

  @@index([provider, createdAt])
  @@index([projectId])
  @@index([userId, createdAt])
  @@index([toolName])
}

// ─────────────────────────────────────────────
//  MARKETPLACE ENHANCEMENT (Phase 10)
//  Reviews, installs, and discovery for agents
// ─────────────────────────────────────────────

model AgentReview {
  id            String   @id @default(cuid())
  agentId       String
  userId        String
  rating        Int      // 1-5 stars
  title         String?  // optional review title
  body          String?  // optional review body
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([agentId, userId])
  @@index([agentId])
  @@index([userId])
}

model AgentInstall {
  id            String   @id @default(cuid())
  agentId       String
  userId        String
  installedAt   DateTime @default(now())

  @@unique([agentId, userId])
  @@index([agentId])
  @@index([userId])
}
